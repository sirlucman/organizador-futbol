{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/football/**",
              "components/forms/**",
              "components/layout/**",
              "components/navigation/**",
              "ui_kits/app/**",
              "ui_kits/marketing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuthFormCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|children|submitLabel|onSubmit|secondary|footnote|style|key|ref|className|style|children)$/]",
        "message": "<AuthFormCard> doesn't accept that prop. Declared props: title, subtitle, children, submitLabel, onSubmit, secondary, footnote, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, icon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:positive|negative|warning|neutral|ink)$/]",
        "message": "<Badge> tone must be one of 'positive' | 'negative' | 'warning' | 'neutral' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|iconLeft|iconRight|fullWidth|disabled|href|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, iconLeft, iconRight, fullWidth, disabled, href, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'tertiary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|padding|eyebrow|title|children|footer|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, padding, eyebrow, title, children, footer, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:content|sage|green|dark|outline)$/]",
        "message": "<Card> variant must be one of 'content' | 'sage' | 'green' | 'dark' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|eyebrow|heading|intro|actions|columns|children|style|key|ref|className|style|children)$/]",
        "message": "<ContentBand> doesn't accept that prop. Declared props: tone, eyebrow, heading, intro, actions, columns, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentBand'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:canvas|sage|dark)$/]",
        "message": "<ContentBand> tone must be one of 'canvas' | 'sage' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|align|width|render|strong|mute|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, label, align, width, render, strong, mute."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<DataTableColumn> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:media|title|caption|action|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: media, title, caption, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|tagline|columns|legal|style|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: brand, tagline, columns, legal, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|scale|eyebrow|headline|subhead|actions|aside|style|key|ref|className|style|children)$/]",
        "message": "<HeroBand> doesn't accept that prop. Declared props: tone, scale, eyebrow, headline, subhead, actions, aside, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroBand'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sage|dark)$/]",
        "message": "<HeroBand> tone must be one of 'sage' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroBand'] > JSXAttribute[name.name='scale'] > Literal[value!=/^(?:mega|xxl|xl|lg)$/]",
        "message": "<HeroBand> scale must be one of 'mega' | 'xxl' | 'xl' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|label|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|variant|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, variant, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:plain|outline|primary)$/]",
        "message": "<IconButton> variant must be one of 'plain' | 'outline' | 'primary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MatchPlannerCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|teams|players|formations|defaultHome|defaultAway|defaultFormation|ctaLabel|onPlan|style|key|ref|className|style|children)$/]",
        "message": "<MatchPlannerCard> doesn't accept that prop. Declared props: eyebrow, teams, players, formations, defaultHome, defaultAway, defaultFormation, ctaLabel, onPlan, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MatchSummaryItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|note|value|key|ref|className|style|children)$/]",
        "message": "<MatchSummaryItem> doesn't accept that prop. Declared props: label, note, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|description|children|actions|onClose|width|style|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, title, description, children, actions, onClose, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|links|actions|sticky|style|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: brand, links, actions, sticky, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|active|icon|children|style|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: href, active, icon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingTier'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|period|description|features|featured|badge|ctaLabel|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<PricingTier> doesn't accept that prop. Declared props: name, price, period, description, features, featured, badge, ctaLabel, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarNavRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|badge|active|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<SidebarNavRow> doesn't accept that prop. Declared props: icon, label, badge, active, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TeamCompositionGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|count|required|key|ref|className|style|children)$/]",
        "message": "<TeamCompositionGroup> doesn't accept that prop. Declared props: label, count, required."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|type|value|onChange|placeholder|iconLeft|suffix|disabled|id|style|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: label, hint, error, type, value, onChange, placeholder, iconLeft, suffix, disabled, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|title|message|action|onDismiss|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: tone, icon, title, message, action, onDismiss, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|positive|warning|negative)$/]",
        "message": "<Toast> tone must be one of 'neutral' | 'positive' | 'warning' | 'negative'."
      }
    ]
  },
